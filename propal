export default function QuizIndice() {
  const [state, setState] = React.useState('question');
  const [answer, setAnswer] = React.useState('');

  const bonneReponse = 'aurel';

  const verifier = () => {
    if (answer.trim().toLowerCase() === bonneReponse) {
      setState('indice');
    } else {
      setState('echec');
    }
  };

  if (state === 'indice') {
    return (
      <div className="min-h-screen flex items-center justify-center bg-green-50 p-6">
        <div className="bg-white rounded-3xl shadow-xl p-8 max-w-xl text-center">
          <h1 className="text-3xl font-bold text-green-700 mb-4">✅ Bonne réponse !</h1>
          <p className="text-lg">Voici votre indice :</p>
          <p className="mt-4 text-2xl font-semibold">super</p>
        </div>
      </div>
    );
  }

  if (state === 'echec') {
    return (
      <div className="min-h-screen flex items-center justify-center bg-red-50 p-6">
        <div className="bg-white rounded-3xl shadow-xl p-8 max-w-xl text-center">
          <h1 className="text-3xl font-bold text-red-700 mb-4">❌ Échec</h1>
          <p className="text-lg">Mauvaise réponse. Vous n'avez pas trouvé la bonne solution.</p>
          <button
            className="mt-6 px-4 py-2 bg-blue-600 text-white rounded-xl"
            onClick={() => {
              setAnswer('');
              setState('question');
            }}
          >
            Réessayer
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen flex items-center justify-center bg-slate-100 p-6">
      <div className="bg-white rounded-3xl shadow-xl p-8 w-full max-w-xl">
        <h1 className="text-3xl font-bold mb-4">Question</h1>
        <p className="mb-4">Qui va rapporter des croissants lundi pro</p>

        <input
          className="w-full border rounded-xl p-3"
          value={answer}
          onChange={(e) => setAnswer(e.target.value)}
          placeholder="Votre réponse"
        />

        <button
          className="w-full mt-4 bg-blue-600 text-white p-3 rounded-xl"
          onClick={verifier}
        >
          Valider
        </button>
      </div>
    </div>
  );
}
